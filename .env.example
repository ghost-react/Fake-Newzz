# ==============================================================================
# FakeNewzz Environment Configuration (.env.example)
# Copy this file to .env.local and populate with your credentials.
# None of these variables are exposed to the client (no NEXT_PUBLIC_ prefixes).
# ==============================================================================

# Firecrawl API key for server-side news article extraction (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Serper API key for real-time Google News & Web evidence search (https://serper.dev)
SERPER_API_KEY=

# Google Gemini API key for structured claim evaluation and synthesis (https://aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic API key as secondary/fallback LLM provider (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Upstash Redis REST URL for per-IP rate limiting and abuse prevention (https://upstash.com)
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token for authenticated Redis commands
UPSTASH_REDIS_REST_TOKEN=

# Maximum daily search/scrape credit budget ceiling before entering maintenance mode (default: 500)
DAILY_BUDGET_CREDITS=

# Opt-in debug execution tracing: set to "true" in development (hard-disabled in production)
FAKENEWZZ_TRACE=

# Cross-source comparison engine feature toggle: "true" to enable
COMPARISON_ENABLED=

# Verification scoring mode: "on" (default), "shadow", or "off"
SCORING_V2=
